# Servidor SMTP usado para enviar os e-mails
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@exemplo.com.br
SMTP_PASS=troque-pela-senha-ou-app-password

# E-mail que recebe os dados de cada lead
MAIL_TO=contato@exemplo.com.br

# Nome/amigável do remetente que aparece na caixa de entrada
MAIL_FROM_NAME="Pátria Sem Fronteiras"

# Origem permitida para chamadas à API (a URL final do site na Vercel)
SITE_ORIGIN=https://seu-dominio.vercel.app
